{
  "name": "eletroposto",
  "version": "0.1.0",
  "private": true,
  "description": "PWA de controle de recargas para eletropostos, com dados salvos no aparelho",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/app.js src/core.js test/",
    "format": "prettier --write src/core.js src/styles.css test/",
    "format:check": "prettier --check src/core.js src/styles.css test/",
    "build": "node scripts/build.mjs",
    "check": "npm run build && npm run lint && npm test"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "jsdom": "^25.0.0",
    "prettier": "^3.0.0",
    "vitest": "^5.0.1"
  }
}
